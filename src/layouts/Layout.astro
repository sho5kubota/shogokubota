---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = '琵琶湖バスフィッシングガイド｜スキルアップ重視・再現性のある釣りを丁寧にサポート',
  description = '琵琶湖を舞台に、釣果だけを追わず、次回以降の釣行につながるスキルアップを重視したバスフィッシングガイド。基本から季節に応じたポイント選び・釣り方まで丁寧にサポートし、他のフィールドでも活かせる釣りを目指します。',
  ogImage = 'https://storage.googleapis.com/production-os-assets/assets/a0db5e5d-b95f-4016-aa53-86fd483a643e',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="all" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://shogokubota.com/" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500&family=Noto+Sans+JP:wght@300;400;500;700&family=Noto+Serif+JP:wght@400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
    <style is:inline>*,*:before,*:after{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}img{max-width:100%;display:block}
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
