---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="琵琶湖 水況モニター | Sho5 Guide Service"
  description="琵琶湖の水温・水位・放水量をリアルタイムにグラフ表示します。データソース: 国土交通省 水文水質データベース / 川の防災情報。"
>
  <header class="mon-header">
    <a href="/" class="mon-logo en-heading">Sho5 Guide Service</a>
    <nav class="mon-nav">
      <a href="/#about">ガイドについて</a>
      <a href="/#records">レコード</a>
      <a href="/#boat">ボートスペック</a>
      <a href="/#price">ガイド料金</a>
      <a href="/monitor" class="active">水況モニター</a>
      <a href="/#contact" class="mon-cta">お問い合わせ</a>
    </nav>
  </header>

  <section class="mon-section">
    <div class="container">
      <span class="section-subtitle en-heading">Lake Biwa Environmental Monitor</span>
      <h2 class="section-title">水況モニター</h2>
      <p class="lead">
        琵琶湖の水温・水位・放水量を国土交通省のデータベースから取得し、グラフで可視化します。
        <span class="updated" id="updated"></span>
        <span class="demo-flag" id="demo-flag" hidden>デモデータ表示中</span>
      </p>

      <div class="cards" id="cards"></div>

      <div class="controls">
        <div class="ranges" id="ranges"></div>
        <button class="reload" id="reload">↻ 更新</button>
      </div>

      <div class="panel">
        <div class="panel-label en-heading">Water Temperature & Level</div>
        <div class="chart-wrap"><canvas id="chart-main"></canvas></div>
        <div class="panel-label en-heading">Discharge — 瀬田川洗堰</div>
        <div class="chart-wrap small"><canvas id="chart-discharge"></canvas></div>
        <div class="overlay" id="overlay" hidden></div>
      </div>

      <div class="setup" id="setup" hidden>
        <h4>Cloudflare Workers セットアップ手順</h4>
        <ol>
          <li><a href="https://dash.cloudflare.com" target="_blank" rel="noopener">dash.cloudflare.com</a> にアクセスしてアカウント作成（無料）</li>
          <li>「Workers &amp; Pages」→「Create」→「Worker」を選択</li>
          <li>リポジトリ内 <code>workers/biwako-proxy/worker.js</code> の内容を貼り付け</li>
          <li>「Deploy」 → URL 発行（例: <code>https://biwako-proxy.xxx.workers.dev</code>）</li>
          <li><code>src/pages/monitor.astro</code> 冒頭の <code>PROXY_BASE</code> をそのURLに書き換えて再デプロイ</li>
        </ol>
      </div>

      <p class="source">データソース: 国土交通省 水文水質データベース / 川の防災情報</p>
    </div>
  </section>

  <footer class="mon-footer">
    <div class="container">
      <p>©2025 SHO5 Guide Service All Rights Reserved.</p>
    </div>
  </footer>

  <script>
    const PROXY_BASE = "https://biwako-proxy.sho5-kubota.workers.dev";
    const USE_DEMO = PROXY_BASE.includes("YOUR-SUBDOMAIN");

    const RANGES = [
      { key: "day",   label: "1日",   days: 1   },
      { key: "week",  label: "1週間", days: 7   },
      { key: "month", label: "1ヶ月", days: 30  },
      { key: "year",  label: "1年",   days: 365 },
    ];

    const METRICS = [
      { key: "temp_bridge", label: "水温 琵琶湖大橋", color: "#5C8AA6", unit: "℃",    axis: "y"  },
      { key: "temp_north",  label: "水温 安曇川沖",   color: "#6B8E5A", unit: "℃",    axis: "y"  },
      { key: "temp_south",  label: "水温 雄琴沖",     color: "#9B7B5C", unit: "℃",    axis: "y"  },
      { key: "level",       label: "水位（琵琶湖）",  color: "#2C2A26", unit: "m",    axis: "y1" },
      { key: "discharge",   label: "放水量（洗堰）",  color: "#8A6B4E", unit: "m³/s", axis: "y"  },
    ];

    const state = {
      range: RANGES[0], data: [],
      visible: Object.fromEntries(METRICS.map(m => [m.key, true])),
      mainChart: null, dischargeChart: null, timer: null,
    };

    function genDemo(days) {
      const now = Date.now();
      const points = days <= 1 ? 144 : days <= 7 ? 168 : days <= 30 ? 240 : 365;
      const interval = (days * 864e5) / points;
      const month = new Date().getMonth();
      const baseTempSeasons = Math.sin(((month - 3) / 12) * 2 * Math.PI) * 8 + 16;
      const noise = () => (Math.random() - 0.5) * 0.4;

      return Array.from({ length: points }, (_, i) => {
        const ts = now - (points - i) * interval;
        const d = new Date(ts);
        const hour = d.getHours() + d.getMinutes() / 60;
        const diurnal = days <= 7 ? Math.sin((hour / 24 - 0.25) * 2 * Math.PI) * 1.2 : 0;
        const tb = +(baseTempSeasons + diurnal + noise()).toFixed(1);
        const tn = +(tb - 1.3 + noise()).toFixed(1);
        const ts2 = +(tb + 0.9 + noise()).toFixed(1);
        const lv = +(0.3 + Math.sin(i / points * Math.PI * 2) * 0.15 + noise() * 0.05).toFixed(2);
        const dc = +(120 + Math.sin(i / points * Math.PI * 3) * 60 + Math.random() * 20).toFixed(0);

        let label;
        if (days <= 1)       label = `${String(d.getHours()).padStart(2,"0")}:${String(d.getMinutes()).padStart(2,"0")}`;
        else if (days <= 7)  label = `${["日","月","火","水","木","金","土"][d.getDay()]} ${String(d.getHours()).padStart(2,"0")}h`;
        else if (days <= 30) label = `${d.getMonth()+1}/${d.getDate()}`;
        else                 label = `${d.getMonth()+1}月`;

        return { label, ts, temp_bridge: tb, temp_north: tn, temp_south: ts2, level: lv, discharge: dc };
      });
    }

    async function fetchAllData(days) {
      if (USE_DEMO) { await new Promise(r => setTimeout(r, 300)); return genDemo(days); }
      try {
        const [lvRes, tmpRes, dcRes] = await Promise.all([
          fetch(`${PROXY_BASE}/water-level`), fetch(`${PROXY_BASE}/water-temp`), fetch(`${PROXY_BASE}/discharge`),
        ]);
        const [lv, tmp, dc] = await Promise.all([lvRes.json(), tmpRes.json(), dcRes.json()]);
        const map = {};
        const merge = (arr, key) => arr?.forEach(pt => {
          const k = pt.time;
          if (!map[k]) map[k] = { label: k.slice(-5), ts: new Date(k.replace(/\//g, "-")).getTime() };
          map[k][key] = pt.value;
        });
        merge(lv.data, "level");
        merge(tmp.results?.temp_bridge?.data, "temp_bridge");
        merge(tmp.results?.temp_north?.data, "temp_north");
        merge(tmp.results?.temp_south?.data, "temp_south");
        merge(dc.data, "discharge");
        const merged = Object.values(map).sort((a, b) => a.ts - b.ts);
        return merged.length ? merged : genDemo(days);
      } catch { return genDemo(days); }
    }

    function renderRanges() {
      const el = document.getElementById("ranges");
      el.innerHTML = "";
      RANGES.forEach(r => {
        const b = document.createElement("button");
        b.textContent = r.label;
        b.className = "range-btn" + (state.range.key === r.key ? " active" : "");
        b.onclick = () => { state.range = r; setupTimer(); load(); };
        el.appendChild(b);
      });
    }

    function renderCards() {
      const el = document.getElementById("cards");
      const latest = state.data[state.data.length - 1];
      el.innerHTML = "";
      METRICS.forEach(m => {
        const card = document.createElement("button");
        card.className = "card" + (state.visible[m.key] ? "" : " off");
        card.style.setProperty("--accent", m.color);
        const val = latest?.[m.key];
        card.innerHTML = `
          <span class="card-label">${m.label}</span>
          <span class="card-value en-heading">${val ?? "—"}<span class="card-unit">${m.unit}</span></span>
        `;
        card.onclick = () => { state.visible[m.key] = !state.visible[m.key]; renderCards(); renderCharts(); };
        el.appendChild(card);
      });
    }

    function tickStep() {
      const k = state.range.key;
      return k === "year" ? 30 : k === "month" ? 6 : 12;
    }

    function renderCharts() {
      const labels = state.data.map(d => d.label);
      const step = tickStep();
      const tempMetrics = METRICS.filter(m => m.key.startsWith("temp_") || m.key === "level");
      const mainDatasets = tempMetrics.filter(m => state.visible[m.key]).map(m => ({
        label: m.label,
        data: state.data.map(d => d[m.key] ?? null),
        borderColor: m.color,
        backgroundColor: m.color + "22",
        borderWidth: m.key === "level" ? 2 : 1.8,
        borderDash: m.key === "level" ? [4, 2] : [],
        yAxisID: m.axis, tension: 0.3, pointRadius: 0, pointHoverRadius: 3, spanGaps: true,
      }));

      const ff = "'Noto Sans JP', 'Montserrat', sans-serif";
      const tickColor = "#666";
      const gridColor = "rgba(0,0,0,0.06)";

      const xAxis = {
        ticks: {
          color: tickColor, font: { size: 10, family: ff }, autoSkip: false,
          callback: (_, i) => i % step === 0 ? labels[i] : "",
        },
        grid: { color: gridColor },
      };

      const tooltipBase = {
        backgroundColor: "#2C2A26",
        titleColor: "#EBE5D9", bodyColor: "#fff",
        borderColor: "#8A6B4E", borderWidth: 1,
        padding: 10,
        titleFont: { family: ff, size: 11, weight: "700" },
        bodyFont: { family: ff, size: 12 }, cornerRadius: 2,
      };

      if (state.mainChart) state.mainChart.destroy();
      if (state.dischargeChart) state.dischargeChart.destroy();

      state.mainChart = new Chart(document.getElementById("chart-main"), {
        type: "line",
        data: { labels, datasets: mainDatasets },
        options: {
          responsive: true, maintainAspectRatio: false,
          interaction: { mode: "index", intersect: false },
          plugins: {
            legend: { labels: { color: "#424242", font: { size: 11, family: ff }, boxWidth: 12 } },
            tooltip: { ...tooltipBase, callbacks: { label: (ctx) => {
              const m = METRICS.find(mm => mm.label === ctx.dataset.label);
              return ` ${ctx.dataset.label}: ${ctx.parsed.y} ${m?.unit ?? ""}`;
            }}},
          },
          scales: {
            x: xAxis,
            y:  { position: "left",  ticks: { color: tickColor, font: { size: 10, family: ff }, callback: v => `${v}°` }, grid: { color: gridColor } },
            y1: { position: "right", ticks: { color: "#2C2A26", font: { size: 10, family: ff }, callback: v => `${v}m` }, grid: { drawOnChartArea: false } },
          },
        },
      });

      state.dischargeChart = new Chart(document.getElementById("chart-discharge"), {
        type: "bar",
        data: { labels, datasets: [{
          label: "放水量",
          data: state.data.map(d => d.discharge ?? null),
          backgroundColor: "rgba(138,107,78,0.55)",
          borderColor: "#8A6B4E", borderWidth: 0,
        }]},
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { ...tooltipBase, callbacks: { label: (ctx) => ` ${ctx.parsed.y} m³/s` } },
          },
          scales: {
            x: xAxis,
            y: { ticks: { color: tickColor, font: { size: 10, family: ff } }, grid: { color: gridColor } },
          },
        },
      });
    }

    async function load() {
      const overlay = document.getElementById("overlay");
      overlay.hidden = false; overlay.textContent = "読み込み中…"; overlay.classList.remove("error");
      try {
        state.data = await fetchAllData(state.range.days);
        document.getElementById("updated").textContent = `最終更新 ${new Date().toLocaleTimeString("ja-JP")}`;
        renderRanges(); renderCards(); renderCharts();
        overlay.hidden = true;
      } catch (e) {
        overlay.classList.add("error"); overlay.textContent = `取得エラー: ${e.message}`;
      }
    }

    function setupTimer() {
      if (state.timer) clearInterval(state.timer);
      if (state.range.key === "day") state.timer = setInterval(load, 10 * 60 * 1000);
    }

    function loadScript(src) {
      return new Promise((resolve, reject) => {
        const s = document.createElement("script");
        s.src = src; s.onload = resolve; s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    (async function init() {
      document.getElementById("demo-flag").hidden = !USE_DEMO;
      document.getElementById("setup").hidden = !USE_DEMO;
      document.getElementById("reload").onclick = load;
      await loadScript("https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js");
      setupTimer(); load();
    })();
  </script>
</Layout>

<style>
  :root {
    --color-bg-light: #F9F8F6;
    --color-bg-dark: #2C2A26;
    --color-bg-tan: #EBE5D9;
    --color-text-dark: #222222;
    --color-text-light: #ffffff;
    --color-text-muted: #666666;
    --color-accent-brown: #8A6B4E;
    --font-en-heading: "Playfair Display", serif;
    --font-ja-heading: "Noto Serif JP", serif;
    --font-body: "Noto Sans JP", sans-serif;
    --font-en-body: "Montserrat", sans-serif;
  }

  body, html {
    font-family: var(--font-body);
    background-color: var(--color-bg-light);
    color: var(--color-text-dark);
    line-height: 1.8;
    font-size: 15px;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
    letter-spacing: 0.03em;
    overflow-x: hidden;
  }

  .en-heading { font-family: var(--font-en-heading); }

  a {
    text-decoration: none;
    transition: opacity 0.3s;
    color: inherit;
  }
  a:hover { opacity: 0.7; }

  /* Header (index と同パターン) */
  .mon-header {
    position: fixed;
    top: 0;
    width: 100%;
    padding: 20px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(44, 42, 38, 0.9);
    backdrop-filter: blur(8px);
    z-index: 1000;
  }
  .mon-logo {
    font-size: 1.4rem;
    color: var(--color-text-light);
    letter-spacing: 0.05em;
  }
  .mon-nav {
    display: flex;
    align-items: center;
  }
  .mon-nav a {
    color: var(--color-text-light);
    margin-left: 30px;
    font-size: 0.85rem;
  }
  .mon-nav a.active {
    color: var(--color-accent-brown);
  }
  .mon-cta {
    border: 1px solid var(--color-accent-brown);
    padding: 10px 24px;
    background: var(--color-accent-brown);
    color: var(--color-text-light) !important;
    font-size: 0.85rem;
    transition: all 0.3s;
  }
  .mon-cta:hover {
    background: transparent;
    color: var(--color-accent-brown) !important;
    opacity: 1;
  }

  /* Section */
  .mon-section {
    padding: 160px 5% 100px;
    background: var(--color-bg-light);
  }
  .container { width: 100%; max-width: 1200px; margin: 0 auto; }

  .section-subtitle {
    color: var(--color-accent-brown);
    font-size: 1.5rem;
    text-align: center;
    margin-bottom: 10px;
    display: block;
    font-style: italic;
  }
  .section-title {
    font-family: var(--font-ja-heading);
    font-weight: 600;
    font-size: 2.5rem;
    margin-bottom: 30px;
    text-align: center;
    letter-spacing: 0.05em;
  }
  .lead {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: 50px;
    font-size: 0.95rem;
  }
  .updated {
    display: inline-block;
    margin-left: 12px;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .demo-flag {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 12px;
    background: var(--color-accent-brown);
    color: #fff;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  /* カード */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }
  .card {
    background: #fff;
    border: 1px solid #e8e2d6;
    border-top: 3px solid var(--accent, var(--color-accent-brown));
    padding: 20px 22px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
    font-family: var(--font-body);
    color: var(--color-text-dark);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    transform: translateY(-2px);
  }
  .card.off {
    opacity: 0.4;
    border-top-color: #ccc;
  }
  .card-label {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }
  .card-value {
    font-size: 2rem;
    color: var(--color-text-dark);
    line-height: 1;
  }
  .card-unit {
    font-size: 0.8rem;
    margin-left: 4px;
    color: var(--color-text-muted);
    font-family: var(--font-body);
  }

  /* コントロール */
  .controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .ranges {
    display: flex;
    border: 1px solid var(--color-accent-brown);
  }
  .range-btn {
    padding: 10px 22px;
    border: none;
    background: transparent;
    color: var(--color-accent-brown);
    font-size: 0.85rem;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.2s;
    border-right: 1px solid var(--color-accent-brown);
  }
  .range-btn:last-child { border-right: none; }
  .range-btn.active {
    background: var(--color-accent-brown);
    color: #fff;
  }
  .reload {
    margin-left: auto;
    padding: 10px 22px;
    border: 1px solid var(--color-text-dark);
    background: transparent;
    color: var(--color-text-dark);
    font-size: 0.85rem;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.2s;
  }
  .reload:hover {
    background: var(--color-text-dark);
    color: #fff;
  }

  /* グラフパネル */
  .panel {
    background: #fff;
    border: 1px solid #e8e2d6;
    padding: 28px;
    position: relative;
  }
  .panel-label {
    font-size: 0.95rem;
    color: var(--color-accent-brown);
    font-style: italic;
    margin-bottom: 12px;
    padding-left: 12px;
    border-left: 3px solid var(--color-accent-brown);
  }
  .chart-wrap { height: 300px; margin-bottom: 30px; }
  .chart-wrap.small { height: 160px; margin-bottom: 0; }
  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(249,248,246,0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    z-index: 20;
  }
  .overlay.error { color: #b94a4a; }

  /* セットアップガイド */
  .setup {
    margin-top: 32px;
    background: var(--color-bg-tan);
    border-left: 3px solid var(--color-accent-brown);
    padding: 24px 28px;
    font-size: 0.88rem;
    line-height: 2;
  }
  .setup h4 {
    font-family: var(--font-ja-heading);
    color: var(--color-accent-brown);
    margin-bottom: 12px;
    font-weight: 600;
  }
  .setup ol { margin: 0; padding-left: 22px; color: var(--color-text-dark); }
  .setup code {
    background: #fff;
    border: 1px solid #d8d2c4;
    padding: 1px 6px;
    font-size: 0.82rem;
    font-family: 'Menlo', 'Courier New', monospace;
  }
  .setup a {
    color: var(--color-accent-brown);
    text-decoration: underline;
  }

  .source {
    margin-top: 32px;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
    letter-spacing: 0.05em;
  }

  /* Footer */
  .mon-footer {
    background-color: #1a1917;
    color: rgba(255,255,255,0.5);
    padding: 40px 5%;
    text-align: center;
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .mon-nav a { display: none; }
    .mon-nav a.mon-cta { display: inline-block; }
    .mon-section { padding: 110px 5% 60px; }
    .section-title { font-size: 1.8rem; }
    .chart-wrap { height: 260px; }
    .panel { padding: 18px; }
    .ranges { width: 100%; }
    .range-btn { flex: 1; padding: 10px 8px; }
    .reload { margin-left: 0; width: 100%; }
  }
  @media (max-width: 480px) {
    .mon-logo { font-size: 1rem; }
    .mon-header { padding: 16px 4%; }
    .mon-cta { padding: 8px 16px; font-size: 0.8rem; }
    .section-title { font-size: 1.5rem; }
    .card-value { font-size: 1.6rem; }
  }
</style>
